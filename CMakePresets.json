{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "generator": "Ninja"
    },
    {
      "name": "debug",
      "displayName": "Debug library",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release library",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "examples",
      "displayName": "Release library and example",
      "inherits": "release",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "validation",
      "displayName": "Debug validation suite",
      "inherits": "debug",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_VALIDATION": "ON"
      }
    },
    {
      "name": "benchmarks",
      "displayName": "Release benchmark suite",
      "inherits": "release",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "all",
      "displayName": "Everything",
      "inherits": "release",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_ALL": "ON"
      }
    },
    {
      "name": "v14-algorithms",
      "displayName": "v1.4 algorithm Release validation and benchmarks",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/v14-algorithms",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_VALIDATION": "ON",
        "SMARTPARALLEL_BUILD_V140_ALGORITHM_BENCHMARKS": "ON",
        "SMARTPARALLEL_BUILD_BENCHMARKS": "OFF",
        "SMARTPARALLEL_ENABLE_TBB": "ON",
        "SMARTPARALLEL_INSTALL": "ON"
      }
    },
    {
      "name": "ci-debug-no-tbb",
      "displayName": "CI Debug validation without oneTBB",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/ci-debug-no-tbb",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_VALIDATION": "ON",
        "SMARTPARALLEL_BUILD_BENCHMARKS": "OFF",
        "SMARTPARALLEL_ENABLE_TBB": "OFF",
        "SMARTPARALLEL_INSTALL": "ON"
      }
    },
    {
      "name": "ci-release-tbb",
      "displayName": "CI Release validation with required oneTBB",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/ci-release-tbb",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_VALIDATION": "ON",
        "SMARTPARALLEL_BUILD_BENCHMARKS": "OFF",
        "SMARTPARALLEL_ENABLE_TBB": "ON",
        "SMARTPARALLEL_REQUIRE_TBB": "ON",
        "SMARTPARALLEL_INSTALL": "ON"
      }
    },
    {
      "name": "ci-sanitizers",
      "displayName": "CI Debug validation with ASan and UBSan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/ci-sanitizers",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_VALIDATION": "ON",
        "SMARTPARALLEL_BUILD_BENCHMARKS": "OFF",
        "SMARTPARALLEL_ENABLE_TBB": "OFF",
        "SMARTPARALLEL_ENABLE_SANITIZERS": "ON",
        "SMARTPARALLEL_INSTALL": "OFF"
      }
    },
    {
      "name": "v15-adaptive-routes",
      "displayName": "v1.5 Adaptive Execution Routes Release validation",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/v15-adaptive-routes",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "vision-opencv",
        "SMARTPARALLEL_BUILD_VISION": "ON",
        "SMARTPARALLEL_ENABLE_OPENCV_PROVIDER": "ON",
        "SMARTPARALLEL_REQUIRE_OPENCV_PROVIDER": "ON",
        "SMARTPARALLEL_BUILD_VALIDATION": "ON",
        "SMARTPARALLEL_BUILD_V150_VISION_VALIDATION": "ON",
        "SMARTPARALLEL_BUILD_V150_VISION_BENCHMARKS": "ON",
        "SMARTPARALLEL_BUILD_BENCHMARKS": "OFF",
        "SMARTPARALLEL_ENABLE_TBB": "ON",
        "SMARTPARALLEL_REQUIRE_TBB": "ON",
        "SMARTPARALLEL_INSTALL": "ON"
      }
    },
    {
      "name": "v16-scientific",
      "displayName": "v1.6 Scientific Foundations Release validation",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/v16-scientific",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_VALIDATION": "ON",
        "SMARTPARALLEL_BUILD_V160_SCIENTIFIC_BENCHMARKS": "ON",
        "SMARTPARALLEL_BUILD_EXAMPLES": "ON",
        "SMARTPARALLEL_BUILD_VISION": "ON",
        "SMARTPARALLEL_ENABLE_OPENCV_PROVIDER": "OFF",
        "SMARTPARALLEL_ENABLE_TBB": "ON",
        "SMARTPARALLEL_INSTALL": "ON"
      }
    },
    {
      "name": "v16-scientific-no-tbb",
      "displayName": "v1.6 Scientific Foundations without oneTBB",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/v16-scientific-no-tbb",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_VALIDATION": "ON",
        "SMARTPARALLEL_BUILD_V160_SCIENTIFIC_BENCHMARKS": "OFF",
        "SMARTPARALLEL_BUILD_VISION": "ON",
        "SMARTPARALLEL_ENABLE_OPENCV_PROVIDER": "OFF",
        "SMARTPARALLEL_ENABLE_TBB": "OFF",
        "SMARTPARALLEL_INSTALL": "ON"
      }
    },
    {
      "name": "v16-scientific-sanitizers",
      "displayName": "v1.6 Scientific Foundations ASan/UBSan",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/v16-scientific-sanitizers",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_V160_SCIENTIFIC_VALIDATION": "ON",
        "SMARTPARALLEL_BUILD_VISION": "ON",
        "SMARTPARALLEL_ENABLE_TBB": "OFF",
        "SMARTPARALLEL_ENABLE_SANITIZERS": "ON",
        "SMARTPARALLEL_INSTALL": "OFF",
        "SMARTPARALLEL_ENABLE_OPENCV_PROVIDER": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "examples",
      "configurePreset": "examples"
    },
    {
      "name": "validation",
      "configurePreset": "validation"
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks"
    },
    {
      "name": "all",
      "configurePreset": "all"
    },
    {
      "name": "ci-debug-no-tbb",
      "configurePreset": "ci-debug-no-tbb"
    },
    {
      "name": "v14-algorithms",
      "configurePreset": "v14-algorithms"
    },
    {
      "name": "ci-release-tbb",
      "configurePreset": "ci-release-tbb"
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers"
    },
    {
      "name": "v15-adaptive-routes",
      "configurePreset": "v15-adaptive-routes"
    },
    {
      "name": "v16-scientific",
      "configurePreset": "v16-scientific"
    },
    {
      "name": "v16-scientific-no-tbb",
      "configurePreset": "v16-scientific-no-tbb"
    },
    {
      "name": "v16-scientific-sanitizers",
      "configurePreset": "v16-scientific-sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "validation",
      "configurePreset": "validation",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "all",
      "configurePreset": "all",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-debug-no-tbb",
      "configurePreset": "ci-debug-no-tbb",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-release-tbb",
      "configurePreset": "ci-release-tbb",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "v14-algorithms",
      "configurePreset": "v14-algorithms",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "v15-adaptive-routes",
      "configurePreset": "v15-adaptive-routes",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "v16-scientific",
      "configurePreset": "v16-scientific",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "v16-scientific-no-tbb",
      "configurePreset": "v16-scientific-no-tbb",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "v16-scientific-sanitizers",
      "configurePreset": "v16-scientific-sanitizers",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
