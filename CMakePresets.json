{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "generator": "Ninja"
    },
    {
      "name": "debug",
      "displayName": "Debug library",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release library",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "examples",
      "displayName": "Release library and example",
      "inherits": "release",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "validation",
      "displayName": "Debug validation suite",
      "inherits": "debug",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_VALIDATION": "ON"
      }
    },
    {
      "name": "benchmarks",
      "displayName": "Release benchmark suite",
      "inherits": "release",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "all",
      "displayName": "Everything",
      "inherits": "release",
      "cacheVariables": {
        "SMARTPARALLEL_BUILD_ALL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "examples",
      "configurePreset": "examples"
    },
    {
      "name": "validation",
      "configurePreset": "validation"
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks"
    },
    {
      "name": "all",
      "configurePreset": "all"
    }
  ],
  "testPresets": [
    {
      "name": "validation",
      "configurePreset": "validation",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "all",
      "configurePreset": "all",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
