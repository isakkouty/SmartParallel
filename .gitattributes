# Keep platform command files executable by their native shells.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.py text eol=lf

# Avoid content rewriting for retained evidence and images.
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
